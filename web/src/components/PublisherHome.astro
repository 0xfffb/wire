---
import Label from "./Label.astro";
import { avatarHue, formatSubscribers, type Publisher } from "../lib/publishers";

interface Props {
  publisher: Publisher;
  subscribed?: boolean;
}

const { publisher, subscribed = false } = Astro.props;
const gated = !subscribed;
const previewClear = 3;
const previewMax = 6;
const holdingsRows = subscribed
  ? publisher.holdings
  : publisher.holdings.filter((row) => row.side !== "flat").slice(0, previewMax);
const fillRows = subscribed ? publisher.fills : publisher.fills.slice(0, previewMax);
const me = publisher.handle === "demo";
const locked = gated && publisher.policy.audience === "subs";
---
<div class="profile">
  <div>
    <div class="identity">
      <span class="avatar" style={`--h:${avatarHue(publisher.handle)}`} {...(me ? { "data-me-avatar": "" } : {})}>{publisher.name.slice(0, 1)}</span>
      <div>
        <h1 {...(me ? { "data-me-name": "" } : {})}>{publisher.name}</h1>
        <div class="who"><span>@{publisher.handle}</span></div>
      </div>
    </div>
    <p class="lede" data-zh={publisher.bio.zh} data-en={publisher.bio.en} {...(me ? { "data-me-bio": "" } : {})}>{publisher.bio.zh}</p>
    <div class="props">
      <div class="prop">
        <span data-i18n="ytd">今年收益</span>
        <b class={publisher.ytd.startsWith("-") ? "down" : "up"}>{publisher.ytd}</b>
      </div>
      <div class="prop">
        <span data-i18n="subscribers">订阅</span>
        <b>{formatSubscribers(publisher.subscribers)}</b>
      </div>
      <div class="prop">
        <span data-i18n="market">市场</span>
        <b class="pills">
          {publisher.markets.map((m) => <Label tone={m} />)}
        </b>
      </div>
    </div>
    {locked ? (
      <p class="lede" data-i18n="subs_only">这份主页仅订阅者可见。</p>
    ) : (
    <>
    <h2 data-i18n="positions">仓位</h2>
    <div class="well">
      <table class="holdings">
        <thead>
          <tr>
            <th data-i18n="symbol">标的</th>
            <th data-i18n="side">方向</th>
            <th class="num" data-i18n="qty">数量</th>
            <th class="num hide-sm" data-i18n="cost">成本</th>
            <th class="num" data-i18n="value">市值</th>
            <th class="num" data-i18n="pnl">盈亏</th>
          </tr>
        </thead>
        <tbody>
          {holdingsRows.map((row, index) => {
            const fog = gated && index >= previewClear;
            const mist = gated && !fog;
            return (
            <tr class:list={[fog && "gated-row"]}>
              <td>
                <strong>{row.code}.<span data-zh={row.name.zh} data-en={row.name.en}>{row.name.zh}</span></strong>
              </td>
              <td>
                <span class:list={[mist && "gated"]} aria-hidden={gated ? "true" : undefined}>
                  {row.side === "long" ? (
                    <Label tone="buy" />
                  ) : row.side === "short" ? (
                    <Label tone="sell" />
                  ) : (
                    <span class="dash">—</span>
                  )}
                </span>
              </td>
              <td class:list={["num", mist && "gated"]}>{row.qty}</td>
              <td class:list={["num", "hide-sm", mist && "gated"]}>{row.cost}</td>
              <td class:list={["num", mist && "gated"]}>{row.value}</td>
              <td class:list={["num", mist && "gated", row.pl.startsWith("+") && "up", row.pl.startsWith("-") && "down"]}>
                {row.pl}
              </td>
            </tr>
            );
          })}
        </tbody>
      </table>
    </div>
    {subscribed ? (
      <p class="note" data-i18n="masked_only">账户号始终掩码。</p>
    ) : null}
    <h2 data-i18n="trades">交易记录</h2>
    {fillRows.length ? (
      <div class="well">
        <table class="holdings">
          <thead>
            <tr>
              <th data-i18n="time">时间</th>
              <th data-i18n="symbol">标的</th>
              <th data-i18n="status">状态</th>
              <th data-i18n="side">方向</th>
              <th data-i18n="currency">货币</th>
              <th class="num" data-i18n="qty">数量</th>
              <th class="num" data-i18n="fill_price">价格</th>
              <th class="num" data-i18n="notional">成交额</th>
            </tr>
          </thead>
          <tbody>
            {fillRows.map((row, index) => {
              const fog = gated && index >= previewClear;
              const mist = gated && !fog;
              return (
              <tr class:list={[fog && "gated-row"]}>
                <td>{row.time}</td>
                <td>
                  <strong>{row.code}.<span data-zh={row.name.zh} data-en={row.name.en}>{row.name.zh}</span></strong>
                </td>
                <td><Label tone="fill" /></td>
                <td>
                  {row.side === "buy" ? <Label tone="buy" /> : <Label tone="sell" />}
                </td>
                <td>{row.currency}</td>
                <td class:list={["num", mist && "gated"]}>{row.qty}</td>
                <td class:list={["num", mist && "gated"]}>{row.price}</td>
                <td class:list={["num", mist && "gated"]}>{row.amount}</td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="note" data-i18n="fills_empty">暂无成交。</p>
    )}
    </>
    )}
  </div>
  <aside>
    <div class="panel">
      {subscribed ? (
        <>
          <h2 style="margin-top:0" data-i18n="subscribed">已订</h2>
          <p class="lede" data-i18n="sub_left">剩余 18 天。到期后需再订。</p>
          <a class="btn ghost block" href="/app" data-i18n="manage_sub">管理订阅</a>
        </>
      ) : (
        <>
          <h2 style="margin-top:0" data-i18n="subscribe">订阅</h2>
          <p class="lede" data-i18n="subscribe_price" data-price={String(publisher.price)}>
            ¥{publisher.price} / 30 天。到期后需再订。
          </p>
          <a class="btn block" href="/login" data-i18n="subscribe_30">订阅 30 天</a>
        </>
      )}
    </div>
  </aside>
</div>
