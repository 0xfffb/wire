<script>
  import { ApiError, getUser } from "../lib/api";
  import { writePublish } from "../lib/publish";

  void getUser()
    .then((user) => {
      document.documentElement.setAttribute("data-publish", user.publishStatus);
      writePublish({ status: user.publishStatus, markets: [], note: "" });
      if (user.publishStatus !== "approved") location.replace("/user/apply");
    })
    .catch((error) => {
      if (error instanceof ApiError && error.status === 401) location.replace("/login");
    });
</script>
