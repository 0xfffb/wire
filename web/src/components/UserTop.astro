<div class="top-actions" id="user-top">
  <span class="pill">
    <i class="pill-dot" aria-hidden="true"></i>
    <span data-i18n="disconnected">未连接</span>
  </span>
</div>
<script>
  import { ApiError, apiGet } from "../lib/api";
  import { applyLocale, readLocale } from "../lib/i18n";

  type BrokerPayload = {
    connected: boolean;
    broker: string | null;
    brokers: Array<{ id: string; name: { zh: string; en: string } }>;
  };

  const root = document.getElementById("user-top");
  void apiGet<BrokerPayload>("/api/user/broker")
    .then((data) => {
      if (!root) return;
      const current = data.brokers.find((item) => item.id === data.broker);
      if (data.connected && current) {
        root.innerHTML = `<span class="pill" data-tone="ok"><i class="pill-dot" aria-hidden="true"></i><span data-zh="${current.name.zh}" data-en="${current.name.en}">${current.name.zh}</span></span>`;
      } else {
        root.innerHTML = `<span class="pill"><i class="pill-dot" aria-hidden="true"></i><span data-i18n="disconnected">未连接</span></span>`;
      }
      applyLocale(readLocale());
    })
    .catch((error) => {
      if (error instanceof ApiError && (error.status === 401 || error.status === 403)) return;
    });
</script>
