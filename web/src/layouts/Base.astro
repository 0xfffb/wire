---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Wire",
  description = "仓位分享平台",
} = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a href="/">Wire</a>
      <nav>
        <a href="/app">控制台</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    font-family: "IBM Plex Sans", "Noto Sans SC", system-ui, sans-serif;
    line-height: 1.5;
    --bg: #f3efe6;
    --ink: #1c1917;
    --accent: #0f766e;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(1200px 500px at 10% -10%, #d9ebe7, transparent 55%),
      linear-gradient(180deg, #f7f3ea, var(--bg));
    color: var(--ink);
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
  }
  header a { color: inherit; text-decoration: none; font-weight: 600; }
  nav a { margin-left: 1rem; font-weight: 500; color: var(--accent); }
  main { padding: 2rem 1.5rem 4rem; max-width: 48rem; }
</style>
