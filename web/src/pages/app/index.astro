---
import Label from "../../components/Label.astro";
import Base from "../../layouts/Base.astro";
import { avatarHue, publishers } from "../../lib/publishers";

const mine = publishers
  .filter((p) => p.handle === "demo" || p.handle === "north")
  .map((p) => ({ ...p, daysLeft: p.handle === "demo" ? 18 : 6 }));
---
<Base title="我的订阅 · Wire" heading="我的订阅" headingKey="subscriptions" titleKey="title_subs" active="app">
  <div class="issue-list">
    {mine.map((p) => {
      const me = p.handle === "demo";
      return (
      <a class="issue" href={`/publishers/${p.handle}/sub`}>
        <div class="issue-main">
          <span class="avatar" style={`--h:${avatarHue(p.handle)}`} {...(me ? { "data-me-avatar": "" } : {})}>{p.name.slice(0, 1)}</span>
          <div class="who">
            <b {...(me ? { "data-me-name": "" } : {})}>{p.name}</b>
            <span class="bio">@{p.handle}</span>
          </div>
        </div>
        <div class="pills hide-sm">
          {p.markets.map((m) => <Label tone={m} />)}
        </div>
        <div class={`col ${p.ytd.startsWith("-") ? "down" : "up"}`}>{p.ytd}</div>
        <div class="col hide-sm" data-i18n="days_left" data-n={String(p.daysLeft)}>剩余 {p.daysLeft} 天</div>
        <div class="col" data-i18n="subscribed">已订</div>
      </a>
      );
    })}
  </div>
</Base>
