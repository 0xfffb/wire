---
import Base from "../layouts/Base.astro";
---
<Base title="仓位 · Wire" heading="仓位" headingKey="nav_positions" titleKey="title_home" shell="guest" active="positions">
  <div class="page">
    <div class="identity">
      <span class="avatar lg" data-me-avatar></span>
      <div>
        <div class="name-row">
          <h1 data-me-name></h1>
          <span class="pill" data-tone="live" data-live-tag hidden><i class="pill-dot"></i><span data-i18n="live">实盘</span></span>
        </div>
        <p class="lede" data-me-bio></p>
        <div class="socials">
          <a data-social="x" target="_blank" rel="noreferrer" data-i18n="social_x" data-i18n-attr="aria-label">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M9.54 6.78 14.7 1h-1.22L9.02 6.02 5.9 1H1.5l5.41 7.87L1.5 15h1.22l4.73-5.5L10.1 15h4.4L9.54 6.78Zm-1.67 1.95-.55-.78L3.38 1.91h1.87l3.52 5.03.55.78 4.58 6.55h-1.87L7.87 8.73Z"/></svg>
          </a>
          <a data-social="web" target="_blank" rel="noreferrer" data-i18n="social_web" data-i18n-attr="aria-label">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="5.25" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M2.75 8h10.5M8 2.75c1.7 1.8 2.55 3.55 2.55 5.25S9.7 11.45 8 13.25C6.3 11.45 5.45 9.7 5.45 8S6.3 4.55 8 2.75Z" fill="none" stroke="currentColor" stroke-width="1.25"/></svg>
          </a>
          <a data-social="yt" target="_blank" rel="noreferrer" data-i18n="social_yt" data-i18n-attr="aria-label">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="1.75" y="3.5" width="12.5" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="1.25"/><path d="M6.75 6.2v3.6L10.1 8 6.75 6.2Z" fill="currentColor"/></svg>
          </a>
        </div>
      </div>
    </div>
    <div data-when-public>
      <div class="props">
        <div class="prop"><span data-i18n="ytd">当前收益</span><b data-public-ytd>—</b></div>
        <div class="prop"><span data-i18n="last_sync">同步</span><b data-public-lastok>—</b></div>
      </div>
      <h2 data-i18n="cash">现金</h2>
      <div class="well" data-public-cash></div>
      <h2 data-i18n="holdings">持仓</h2>
      <div class="well" data-public-holdings></div>
      <div data-when-fills>
        <h2 data-i18n="recent_orders">最近订单</h2>
        <div class="well" data-public-orders></div>
      </div>
    </div>
    <p class="lede" data-when-private data-i18n="private_book">仓位未公开。</p>
    <p class="lede" data-when-nosync hidden data-i18n="no_snapshot">还没有同步。</p>
  </div>
</Base>

<script>
  import { paintPublic } from "../lib/book";

  void paintPublic();
</script>
