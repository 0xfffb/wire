---
import Label from "../../components/Label.astro";
import PublisherGate from "../../components/PublisherGate.astro";
import PublisherTop from "../../components/PublisherTop.astro";
import Base from "../../layouts/Base.astro";
import { brokers, consoleMe } from "../../lib/console";

const current = brokers.find((item) => item.id === consoleMe.broker);
---
<Base title="概览 · Wire" heading="概览" headingKey="nav_overview" titleKey="title_overview" active="overview">
  <PublisherGate />
  <PublisherTop slot="topbar" />

  <div class="page">
    <div class="props">
      <div class="prop"><span data-i18n="connection">连接</span><b data-i18n="connected">已连接</b></div>
      <div class="prop">
        <span data-i18n="broker">券商</span>
        <b data-zh={current?.name.zh} data-en={current?.name.en}>{current?.name.zh}</b>
      </div>
      <div class="prop"><span data-i18n="accounts">纳入账户</span><b>{consoleMe.accounts.filter((a) => a.on).length}</b></div>
      <div class="prop"><span data-i18n="ytd">今年收益</span><b class="up">{consoleMe.ytd}</b></div>
      <div class="prop"><span data-i18n="symbols">标的数</span><b>{consoleMe.symbols}</b></div>
      <div class="prop"><span data-i18n="today_events">今日变动</span><b>{consoleMe.todayEvents}</b></div>
    </div>
    <h2 data-i18n="activity">最近变动</h2>
    <div class="well">
      <ul class="feed">
        {consoleMe.events.map((item) => (
          <li>
            <span class="feed-main">
              {item.kind === "fill" ? <Label tone="fill" /> : null}
              {item.side === "buy" ? <Label tone="buy" /> : item.side === "sell" ? <Label tone="sell" /> : null}
              <span data-zh={item.text.zh} data-en={item.text.en}>{item.text.zh}</span>
            </span>
            <time data-zh={item.time.zh} data-en={item.time.en}>{item.time.zh}</time>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Base>
