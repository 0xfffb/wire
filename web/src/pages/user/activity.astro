---
import UserGate from "../../components/UserGate.astro";
import UserTop from "../../components/UserTop.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="记录 · Wire" heading="记录" headingKey="nav_records" titleKey="title_records" active="records">
  <UserGate />
  <UserTop slot="topbar" />

  <div class="page">
    <h2 style="margin-top:0" data-i18n="trades">交易记录</h2>
    <div id="orders-wrap">
      <p class="note" data-i18n="fills_empty">暂无成交。</p>
    </div>
  </div>
</Base>

<script>
  import { apiGet, type PublicFill } from "../../lib/api";
  import { applyLocale, readLocale } from "../../lib/i18n";
  import { esc, pill, sidePill, symbolCell } from "../../lib/markup";

  type Order = PublicFill & { qty: string; price: string; amount: string };

  void apiGet<{ orders: Order[] }>("/api/user/orders").then((data) => {
    const wrap = document.getElementById("orders-wrap");
    if (!wrap) return;
    if (!data.orders.length) {
      wrap.innerHTML = `<p class="note" data-i18n="fills_empty">暂无成交。</p>`;
      applyLocale(readLocale());
      return;
    }
    wrap.innerHTML = `<div class="well"><table class="holdings">
      <thead><tr>
        <th data-i18n="time">时间</th>
        <th data-i18n="symbol">标的</th>
        <th data-i18n="status">状态</th>
        <th data-i18n="side">方向</th>
        <th data-i18n="currency">货币</th>
        <th class="num" data-i18n="qty">数量</th>
        <th class="num" data-i18n="fill_price">价格</th>
        <th class="num" data-i18n="notional">成交额</th>
      </tr></thead>
      <tbody>${data.orders
        .map(
          (row) => `<tr>
            <td>${esc(row.time)}</td>
            <td>${symbolCell(row.code, row.name)}</td>
            <td>${pill("fill")}</td>
            <td>${sidePill(row.side)}</td>
            <td>${esc(row.currency)}</td>
            <td class="num">${esc(row.qty)}</td>
            <td class="num">${esc(row.price)}</td>
            <td class="num">${esc(row.amount)}</td>
          </tr>`,
        )
        .join("")}</tbody>
    </table></div>`;
    applyLocale(readLocale());
  });
</script>
