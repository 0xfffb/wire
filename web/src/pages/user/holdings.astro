---
import UserGate from "../../components/UserGate.astro";
import UserTop from "../../components/UserTop.astro";
import Base from "../../layouts/Base.astro";
---
<Base title="持仓 · Wire" heading="持仓" headingKey="nav_holdings" titleKey="title_holdings" active="holdings">
  <UserGate />
  <UserTop slot="topbar" />

  <div class="toolbar" id="accounts"></div>

  <div class="page" style="padding-top:0">
    <div class="well">
      <table class="holdings">
        <thead>
          <tr>
            <th data-i18n="symbol">标的</th>
            <th data-i18n="side">方向</th>
            <th class="num" data-i18n="qty">数量</th>
            <th class="num hide-sm" data-i18n="cost">成本</th>
            <th class="num" data-i18n="value">市值</th>
            <th class="num" data-i18n="pnl">盈亏</th>
          </tr>
        </thead>
        <tbody id="holdings-body"></tbody>
      </table>
    </div>
  </div>
</Base>

<script>
  import { apiGet, type ConsoleAccount, type ConsoleHolding } from "../../lib/api";
  import { applyLocale, readLocale } from "../../lib/i18n";
  import { esc, numClass, sidePill, symbolCell } from "../../lib/markup";

  const chips = document.getElementById("accounts");
  const body = document.getElementById("holdings-body");
  let account = "all";

  function filterRows() {
    for (const row of document.querySelectorAll<HTMLElement>("tr[data-account]")) {
      row.classList.toggle("hidden", account !== "all" && row.dataset.account !== account);
    }
  }

  chips?.addEventListener("click", (event) => {
    const btn = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-account]");
    if (!btn) return;
    account = btn.dataset.account ?? "all";
    chips.querySelectorAll(".chip").forEach((el) => el.classList.toggle("is-on", el === btn));
    filterRows();
  });

  void apiGet<{ accounts: ConsoleAccount[]; holdings: ConsoleHolding[] }>("/api/user/holdings").then((data) => {
    if (chips) {
      chips.innerHTML = `<button class="chip is-on" type="button" data-account="all" data-i18n="all">全部</button>${data.accounts
        .map((acc) => `<button class="chip" type="button" data-account="${esc(acc.mask)}">${esc(acc.mask)}</button>`)
        .join("")}`;
    }
    if (body) {
      body.innerHTML = data.holdings.length
        ? data.holdings
            .map(
              (row) => `<tr data-account="${esc(row.account)}">
            <td>${symbolCell(row.code, row.name)}</td>
            <td>${sidePill(row.side)}</td>
            <td class="num">${esc(row.qty)}</td>
            <td class="num hide-sm">${esc(row.cost)}</td>
            <td class="num">${esc(row.value)}</td>
            <td ${numClass(row.pl)}>${esc(row.pl)}</td>
          </tr>`,
            )
            .join("")
        : `<tr><td colspan="6"><p class="note" data-i18n="holdings_empty">暂无仓位。</p></td></tr>`;
    }
    applyLocale(readLocale());
  });
</script>
