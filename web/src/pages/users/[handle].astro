---
import PublisherHome from "../../components/PublisherHome.astro";
import Base from "../../layouts/Base.astro";
import { publisherByHandle, publishers } from "../../lib/publishers";

export function getStaticPaths() {
  return publishers.map((p) => ({ params: { handle: p.handle } }));
}

const publisher = publisherByHandle(Astro.params.handle);
---
<Base title={`${publisher.name} · Wire`} heading={publisher.name} active="discover" meName={publisher.handle === "demo"}>
  <a slot="topbar" class="crumb" href="/" data-i18n="discover">发现</a>
  <PublisherHome publisher={publisher} />
</Base>
